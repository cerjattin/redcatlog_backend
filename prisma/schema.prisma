generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique(map: "name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users       User[]

  @@map("roles")
}

model User {
  id                    BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  roleId                BigInt               @map("role_id") @db.UnsignedBigInt
  firstName             String               @map("first_name") @db.VarChar(100)
  lastName              String               @map("last_name") @db.VarChar(100)
  email                 String               @unique(map: "uq_users_email") @db.VarChar(180)
  passwordHash          String               @map("password_hash") @db.VarChar(255)
  passwordChangedAt     DateTime?            @map("password_changed_at") @db.DateTime(0)
  forcePasswordChange   Boolean              @default(false) @map("force_password_change")
  phone                 String?              @db.VarChar(30)
  whatsapp              String?              @db.VarChar(30)
  profilePhotoUrl       String?              @map("profile_photo_url") @db.VarChar(500)
  bio                   String?              @db.Text
  city                  String?              @db.VarChar(120)
  department            String?              @db.VarChar(120)
  country               String?              @default("Colombia") @db.VarChar(120)
  status                UserStatus           @default(pending)
  emailVerifiedAt       DateTime?            @map("email_verified_at") @db.DateTime(0)
  lastLoginAt           DateTime?            @map("last_login_at") @db.DateTime(0)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt             DateTime?            @map("deleted_at") @db.DateTime(0)
  approvalLogs          ApprovalLog[]        @relation("ApprovalReviewedBy")
  auditLogs             AuditLog[]
  approvedEntrepreneurs Entrepreneur[]       @relation("EntrepreneurApprovedBy")
  entrepreneur          Entrepreneur?        @relation("UserEntrepreneur")
  uploadedMediaFiles    MediaFile[]          @relation("MediaUploadedBy")
  passwordResetTokens   PasswordResetToken[]
  approvedProducts      Product[]            @relation("ProductApprovedBy")
  sessions              UserSession[]
  role                  Role                 @relation(fields: [roleId], references: [id], onUpdate: Restrict, map: "fk_users_role")

  @@index([createdAt], map: "idx_users_created_at")
  @@index([roleId], map: "idx_users_role_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model Entrepreneur {
  id              BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt?            @unique(map: "uq_entrepreneurs_user") @map("user_id") @db.UnsignedBigInt
  categoryId      BigInt?            @map("category_id") @db.UnsignedBigInt
  firstName       String             @map("first_name") @db.VarChar(100)
  lastName        String             @map("last_name") @db.VarChar(100)
  slug            String             @unique(map: "uq_entrepreneurs_slug") @db.VarChar(180)
  photoUrl        String?            @map("photo_url") @db.VarChar(500)
  bannerUrl       String?            @map("banner_url") @db.VarChar(500)
  email           String?            @db.VarChar(180)
  phone           String?            @db.VarChar(30)
  whatsapp        String?            @db.VarChar(30)
  facebookUrl     String?            @map("facebook_url") @db.VarChar(500)
  instagramUrl    String?            @map("instagram_url") @db.VarChar(500)
  tiktokUrl       String?            @map("tiktok_url") @db.VarChar(500)
  youtubeUrl      String?            @map("youtube_url") @db.VarChar(500)
  websiteUrl      String?            @map("website_url") @db.VarChar(500)
  documentType    String?            @map("document_type") @db.VarChar(30)
  documentNumber  String?            @map("document_number") @db.VarChar(50)
  personalStory   String?            @map("personal_story") @db.Text
  shortBio        String?            @map("short_bio") @db.VarChar(500)
  locationText    String?            @map("location_text") @db.VarChar(255)
  city            String?            @db.VarChar(120)
  department      String?            @db.VarChar(120)
  country         String?            @default("Colombia") @db.VarChar(120)
  status          EntrepreneurStatus @default(draft)
  isFeatured      Boolean            @default(false) @map("is_featured")
  featuredOrder   Int?               @map("featured_order")
  approvedAt      DateTime?          @map("approved_at") @db.DateTime(0)
  approvedBy      BigInt?            @map("approved_by") @db.UnsignedBigInt
  rejectedAt      DateTime?          @map("rejected_at") @db.DateTime(0)
  rejectionReason String?            @map("rejection_reason") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  approvedByUser  User?              @relation("EntrepreneurApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_entrepreneurs_approved_by")
  category        Category?          @relation("EntrepreneurCategory", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_entrepreneurs_category")
  user            User?              @relation("UserEntrepreneur", fields: [userId], references: [id], onUpdate: Restrict, map: "fk_entrepreneurs_user")
  products        Product[]          @relation("EntrepreneurProducts")

  @@unique([documentType, documentNumber], map: "uq_entrepreneurs_document")
  @@index([approvedBy], map: "fk_entrepreneurs_approved_by")
  @@index([categoryId], map: "idx_entrepreneurs_category_id")
  @@index([city], map: "idx_entrepreneurs_city")
  @@index([department], map: "idx_entrepreneurs_department")
  @@index([isFeatured, featuredOrder], map: "idx_entrepreneurs_featured")
  @@index([status], map: "idx_entrepreneurs_status")
  @@map("entrepreneurs")
}

model Category {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  parentId      BigInt?        @map("parent_id") @db.UnsignedBigInt
  name          String         @db.VarChar(120)
  slug          String         @unique(map: "uq_categories_slug") @db.VarChar(160)
  description   String?        @db.Text
  iconUrl       String?        @map("icon_url") @db.VarChar(500)
  type          CategoryType   @default(both)
  sortOrder     Int            @default(0) @map("sort_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_categories_parent")
  children      Category[]     @relation("CategoryHierarchy")
  entrepreneurs Entrepreneur[] @relation("EntrepreneurCategory")
  products      Product[]      @relation("ProductCategory")

  @@index([isActive], map: "idx_categories_active")
  @@index([parentId], map: "idx_categories_parent_id")
  @@index([sortOrder], map: "idx_categories_sort_order")
  @@index([type], map: "idx_categories_type")
  @@map("categories")
}

model Product {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  entrepreneurId   BigInt           @map("entrepreneur_id") @db.UnsignedBigInt
  categoryId       BigInt?          @map("category_id") @db.UnsignedBigInt
  name             String           @db.VarChar(160)
  slug             String           @db.VarChar(180)
  shortDescription String?          @map("short_description") @db.VarChar(500)
  description      String?          @db.Text
  price            Decimal?         @db.Decimal(12, 2)
  hasPrice         Boolean          @default(true) @map("has_price")
  stock            Int?
  managesStock     Boolean          @default(false) @map("manages_stock")
  status           ReviewableStatus @default(draft)
  isFeatured       Boolean          @default(false) @map("is_featured")
  featuredOrder    Int?             @map("featured_order")
  approvedAt       DateTime?        @map("approved_at") @db.DateTime(0)
  approvedBy       BigInt?          @map("approved_by") @db.UnsignedBigInt
  rejectedAt       DateTime?        @map("rejected_at") @db.DateTime(0)
  rejectionReason  String?          @map("rejection_reason") @db.Text
  publishedAt      DateTime?        @map("published_at") @db.DateTime(0)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  images           ProductImage[]
  approvedByUser   User?            @relation("ProductApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_approved_by")
  category         Category?        @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_category")
  entrepreneur     Entrepreneur     @relation("EntrepreneurProducts", fields: [entrepreneurId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_products_entrepreneur")

  @@unique([entrepreneurId, slug], map: "uq_products_entrepreneur_slug")
  @@index([approvedBy], map: "fk_products_approved_by")
  @@index([categoryId], map: "idx_products_category_id")
  @@index([createdAt], map: "idx_products_created_at")
  @@index([entrepreneurId], map: "idx_products_entrepreneur_id")
  @@index([isFeatured, featuredOrder], map: "idx_products_featured")
  @@index([status], map: "idx_products_status")
  @@fulltext([name, shortDescription, description], map: "ft_products_search")
  @@map("products")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  imageUrl  String   @map("image_url") @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(180)
  sortOrder Int      @default(1) @map("sort_order") @db.UnsignedTinyInt
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_product_images_product")

  @@unique([productId, sortOrder], map: "uq_product_images_order")
  @@index([productId, isMain], map: "idx_product_images_main")
  @@index([productId], map: "idx_product_images_product_id")
  @@map("product_images")
}

model MediaFile {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  fileUrl        String             @map("file_url") @db.VarChar(500)
  fileType       MediaFileType      @default(image) @map("file_type")
  mimeType       String?            @map("mime_type") @db.VarChar(120)
  originalName   String?            @map("original_name") @db.VarChar(255)
  title          String?            @db.VarChar(180)
  description    String?            @db.Text
  altText        String?            @map("alt_text") @db.VarChar(180)
  sizeBytes      BigInt?            @map("size_bytes") @db.UnsignedBigInt
  width          Int?
  height         Int?
  uploadedBy     BigInt?            @map("uploaded_by") @db.UnsignedBigInt
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  uploadedByUser User?              @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_media_uploaded_by")
  galleryItems   MediaGalleryItem[]

  @@index([uploadedBy], map: "fk_media_uploaded_by")
  @@map("media_files")
}

model MediaGallery {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  name        String             @db.VarChar(160)
  slug        String             @unique(map: "uq_media_galleries_slug") @db.VarChar(180)
  description String?            @db.Text
  locationKey String?            @map("location_key") @db.VarChar(100)
  status      PublishStatus      @default(draft)
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  items       MediaGalleryItem[]

  @@map("media_galleries")
}

model MediaGalleryItem {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  galleryId   BigInt       @map("gallery_id") @db.UnsignedBigInt
  mediaFileId BigInt       @map("media_file_id") @db.UnsignedBigInt
  title       String?      @db.VarChar(180)
  caption     String?      @db.VarChar(255)
  linkUrl     String?      @map("link_url") @db.VarChar(500)
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  gallery     MediaGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_gallery_items_gallery")
  mediaFile   MediaFile    @relation(fields: [mediaFileId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_gallery_items_media")

  @@index([mediaFileId], map: "fk_gallery_items_media")
  @@index([galleryId], map: "idx_gallery_items_gallery")
  @@map("media_gallery_items")
}

model CmsPage {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  title           String        @db.VarChar(180)
  slug            String        @unique(map: "uq_cms_pages_slug") @db.VarChar(180)
  metaTitle       String?       @map("meta_title") @db.VarChar(180)
  metaDescription String?       @map("meta_description") @db.VarChar(255)
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at") @db.DateTime(0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  sections        CmsSection[]

  @@map("cms_pages")
}

model CmsSection {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  pageId      BigInt        @map("page_id") @db.UnsignedBigInt
  sectionKey  String        @map("section_key") @db.VarChar(100)
  title       String?       @db.VarChar(180)
  subtitle    String?       @db.VarChar(255)
  content     String?       @db.LongText
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  buttonLabel String?       @map("button_label") @db.VarChar(120)
  buttonUrl   String?       @map("button_url") @db.VarChar(500)
  sortOrder   Int           @default(0) @map("sort_order")
  status      PublishStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  page        CmsPage       @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cms_sections_page")

  @@unique([pageId, sectionKey], map: "uq_cms_page_section")
  @@map("cms_sections")
}

model SiteSetting {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  settingKey   String      @unique(map: "uq_site_settings_key") @map("setting_key") @db.VarChar(120)
  settingValue String?     @map("setting_value") @db.Text
  settingType  SettingType @default(text) @map("setting_type")
  isPublic     Boolean     @default(false) @map("is_public")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("site_settings")
}

model ApprovalLog {
  id             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  entityType     approval_logs_entity_type @map("entity_type")
  entityId       BigInt                    @map("entity_id") @db.UnsignedBigInt
  previousStatus String?                   @map("previous_status") @db.VarChar(50)
  newStatus      String                    @map("new_status") @db.VarChar(50)
  reviewedBy     BigInt?                   @map("reviewed_by") @db.UnsignedBigInt
  reviewComment  String?                   @map("review_comment") @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamp(0)
  reviewedByUser User?                     @relation("ApprovalReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_logs_reviewed_by")

  @@index([entityType, entityId], map: "idx_approval_logs_entity")
  @@index([reviewedBy], map: "idx_approval_logs_reviewed_by")
  @@map("approval_logs")
}

model FeaturedItem {
  id          BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  entityType  featured_items_entity_type @map("entity_type")
  entityId    BigInt                     @map("entity_id") @db.UnsignedBigInt
  title       String?                    @db.VarChar(180)
  description String?                    @db.VarChar(255)
  sortOrder   Int                        @default(0) @map("sort_order")
  startsAt    DateTime?                  @map("starts_at") @db.DateTime(0)
  endsAt      DateTime?                  @map("ends_at") @db.DateTime(0)
  isActive    Boolean                    @default(true) @map("is_active")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([entityType, entityId], map: "uq_featured_entity")
  @@index([isActive, sortOrder], map: "idx_featured_items_active")
  @@index([entityType, entityId], map: "idx_featured_items_entity")
  @@map("featured_items")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt?     @map("user_id") @db.UnsignedBigInt
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(80)
  entityId    BigInt?     @map("entity_id") @db.UnsignedBigInt
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  oldValues   String?     @map("old_values") @db.LongText
  newValues   String?     @map("new_values") @db.LongText
  description String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs_user")

  @@index([action], map: "idx_audit_logs_action")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

model UserSession {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_sessions_user")

  @@index([userId], map: "fk_user_sessions_user")
  @@map("user_sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent") @db.Text
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_password_reset_user")

  @@index([tokenHash], map: "idx_password_reset_token_hash")
  @@index([expiresAt], map: "idx_password_reset_expires_at")
  @@index([userId], map: "fk_password_reset_user")
  @@map("password_reset_tokens")
}

enum UserStatus {
  pending
  active
  inactive
  blocked
  deleted
}

enum EntrepreneurStatus {
  draft
  pending_review
  approved
  rejected
  inactive
}

enum CategoryType {
  entrepreneur
  product
  both
}

enum PublishStatus {
  draft
  published
  inactive
  archived
}

enum ReviewableStatus {
  draft
  pending_review
  approved
  published
  rejected
  inactive
  archived
}

enum MediaFileType {
  image
  video
  document
  other
}

enum SettingType {
  text
  number
  boolean
  json
  url
  email
}

enum AuditAction {
  login
  logout
  create
  update
  delete
  approve
  reject
  publish
  unpublish
  status_change
}

enum approval_logs_entity_type {
  entrepreneur
  product
  category
  cms_section
  media
}

enum featured_items_entity_type {
  entrepreneur
  product
}
