generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  active
  inactive
  blocked
  deleted
}

enum EntrepreneurStatus {
  draft
  pending_review
  approved
  rejected
  inactive
}

enum CategoryType {
  business
  product
  both
}

enum PublishStatus {
  draft
  published
  inactive
  archived
}

enum ReviewableStatus {
  draft
  pending_review
  approved
  published
  rejected
  inactive
  archived
}

enum SocialPlatform {
  facebook
  instagram
  tiktok
  youtube
  linkedin
  website
  other
}

enum MediaFileType {
  image
  video
  document
  other
}

enum SettingType {
  text
  number
  boolean
  json
  url
  email
}

enum ApprovalEntityType {
  entrepreneur
  business
  product
  cms_section
  media
}

enum FeaturedEntityType {
  business
  product
}

enum AuditAction {
  login
  logout
  create
  update
  delete
  approve
  reject
  publish
  unpublish
  status_change
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id                  BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  roleId              BigInt     @map("role_id") @db.UnsignedBigInt
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  email               String     @unique @db.VarChar(180)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  passwordChangedAt   DateTime?  @map("password_changed_at")
  forcePasswordChange Boolean    @default(false) @map("force_password_change")
  phone               String?    @db.VarChar(30)
  whatsapp            String?    @db.VarChar(30)
  profilePhotoUrl     String?    @map("profile_photo_url") @db.VarChar(500)
  bio                 String?    @db.Text
  city                String?    @db.VarChar(120)
  department          String?    @db.VarChar(120)
  country             String?    @default("Colombia") @db.VarChar(120)
  status              UserStatus @default(pending)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  role                  Role                 @relation(fields: [roleId], references: [id])
  entrepreneur          Entrepreneur?        @relation("UserEntrepreneur")
  approvedEntrepreneurs Entrepreneur[]       @relation("EntrepreneurApprovedBy")
  approvedBusinesses    Business[]           @relation("BusinessApprovedBy")
  approvedProducts      Product[]            @relation("ProductApprovedBy")
  uploadedMediaFiles    MediaFile[]          @relation("MediaUploadedBy")
  approvalLogs          ApprovalLog[]        @relation("ApprovalReviewedBy")
  auditLogs             AuditLog[]
  sessions              UserSession[]
  passwordResetTokens   PasswordResetToken[]

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Entrepreneur {
  id              BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt             @unique @map("user_id") @db.UnsignedBigInt
  documentType    String?            @map("document_type") @db.VarChar(30)
  documentNumber  String?            @map("document_number") @db.VarChar(50)
  personalStory   String?            @map("personal_story") @db.Text
  shortBio        String?            @map("short_bio") @db.VarChar(500)
  locationText    String?            @map("location_text") @db.VarChar(255)
  city            String?            @db.VarChar(120)
  department      String?            @db.VarChar(120)
  country         String?            @default("Colombia") @db.VarChar(120)
  status          EntrepreneurStatus @default(draft)
  approvedAt      DateTime?          @map("approved_at")
  approvedBy      BigInt?            @map("approved_by") @db.UnsignedBigInt
  rejectedAt      DateTime?          @map("rejected_at")
  rejectionReason String?            @map("rejection_reason") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user           User       @relation("UserEntrepreneur", fields: [userId], references: [id])
  approvedByUser User?      @relation("EntrepreneurApprovedBy", fields: [approvedBy], references: [id])
  businesses     Business[]

  @@index([status])
  @@index([city])
  @@index([department])
  @@index([approvedBy])
  @@map("entrepreneurs")
}

model Category {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  parentId    BigInt?      @map("parent_id") @db.UnsignedBigInt
  name        String       @db.VarChar(120)
  slug        String       @unique @db.VarChar(160)
  description String?      @db.Text
  iconUrl     String?      @map("icon_url") @db.VarChar(500)
  type        CategoryType @default(both)
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  businesses Business[]
  products   Product[]

  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Business {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  entrepreneurId   BigInt           @map("entrepreneur_id") @db.UnsignedBigInt
  mainCategoryId   BigInt?          @map("main_category_id") @db.UnsignedBigInt
  name             String           @db.VarChar(160)
  slug             String           @unique @db.VarChar(180)
  shortDescription String?          @map("short_description") @db.VarChar(500)
  description      String?          @db.Text
  story            String?          @db.Text
  logoUrl          String?          @map("logo_url") @db.VarChar(500)
  bannerUrl        String?          @map("banner_url") @db.VarChar(500)
  contactEmail     String?          @map("contact_email") @db.VarChar(180)
  contactPhone     String?          @map("contact_phone") @db.VarChar(30)
  contactWhatsapp  String?          @map("contact_whatsapp") @db.VarChar(30)
  city             String?          @db.VarChar(120)
  department       String?          @db.VarChar(120)
  country          String?          @default("Colombia") @db.VarChar(120)
  addressText      String?          @map("address_text") @db.VarChar(255)
  facebookUrl      String?          @map("facebook_url") @db.VarChar(500)
  instagramUrl     String?          @map("instagram_url") @db.VarChar(500)
  tiktokUrl        String?          @map("tiktok_url") @db.VarChar(500)
  websiteUrl       String?          @map("website_url") @db.VarChar(500)
  status           ReviewableStatus @default(draft)
  isFeatured       Boolean          @default(false) @map("is_featured")
  featuredOrder    Int?             @map("featured_order")
  publishedAt      DateTime?        @map("published_at")
  approvedAt       DateTime?        @map("approved_at")
  approvedBy       BigInt?          @map("approved_by") @db.UnsignedBigInt
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionReason  String?          @map("rejection_reason") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  entrepreneur   Entrepreneur         @relation(fields: [entrepreneurId], references: [id])
  mainCategory   Category?            @relation(fields: [mainCategoryId], references: [id])
  approvedByUser User?                @relation("BusinessApprovedBy", fields: [approvedBy], references: [id])
  products       Product[]
  socialLinks    BusinessSocialLink[]

  @@index([entrepreneurId])
  @@index([mainCategoryId])
  @@index([approvedBy])
  @@index([status])
  @@index([isFeatured, featuredOrder])
  @@index([department, city])
  @@map("businesses")
}

model BusinessSocialLink {
  id         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  businessId BigInt         @map("business_id") @db.UnsignedBigInt
  platform   SocialPlatform
  label      String?        @db.VarChar(100)
  url        String         @db.VarChar(500)
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_social_links")
}

model Product {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  businessId       BigInt           @map("business_id") @db.UnsignedBigInt
  categoryId       BigInt?          @map("category_id") @db.UnsignedBigInt
  name             String           @db.VarChar(160)
  slug             String           @db.VarChar(180)
  shortDescription String?          @map("short_description") @db.VarChar(500)
  description      String?          @db.Text
  price            Decimal?         @db.Decimal(12, 2)
  hasPrice         Boolean          @default(true) @map("has_price")
  stock            Int?
  managesStock     Boolean          @default(false) @map("manages_stock")
  status           ReviewableStatus @default(draft)
  isFeatured       Boolean          @default(false) @map("is_featured")
  featuredOrder    Int?             @map("featured_order")
  approvedAt       DateTime?        @map("approved_at")
  approvedBy       BigInt?          @map("approved_by") @db.UnsignedBigInt
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionReason  String?          @map("rejection_reason") @db.Text
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id])
  approvedByUser User?          @relation("ProductApprovedBy", fields: [approvedBy], references: [id])
  images         ProductImage[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([approvedBy])
  @@index([status])
  @@index([isFeatured, featuredOrder])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  imageUrl  String   @map("image_url") @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(180)
  sortOrder Int      @default(1) @map("sort_order") @db.UnsignedTinyInt
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
  @@index([productId, isMain])
  @@map("product_images")
}

model MediaFile {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  fileUrl      String        @map("file_url") @db.VarChar(500)
  fileType     MediaFileType @default(image) @map("file_type")
  mimeType     String?       @map("mime_type") @db.VarChar(120)
  originalName String?       @map("original_name") @db.VarChar(255)
  title        String?       @db.VarChar(180)
  description  String?       @db.Text
  altText      String?       @map("alt_text") @db.VarChar(180)
  sizeBytes    BigInt?       @map("size_bytes") @db.UnsignedBigInt
  width        Int?
  height       Int?
  uploadedBy   BigInt?       @map("uploaded_by") @db.UnsignedBigInt
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  uploadedByUser User?              @relation("MediaUploadedBy", fields: [uploadedBy], references: [id])
  galleryItems   MediaGalleryItem[]

  @@index([uploadedBy])
  @@map("media_files")
}

model MediaGallery {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name        String        @db.VarChar(160)
  slug        String        @unique @db.VarChar(180)
  description String?       @db.Text
  locationKey String?       @map("location_key") @db.VarChar(100)
  status      PublishStatus @default(draft)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  items MediaGalleryItem[]

  @@index([status])
  @@index([sortOrder])
  @@map("media_galleries")
}

model MediaGalleryItem {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  galleryId   BigInt   @map("gallery_id") @db.UnsignedBigInt
  mediaFileId BigInt   @map("media_file_id") @db.UnsignedBigInt
  title       String?  @db.VarChar(180)
  caption     String?  @db.VarChar(255)
  linkUrl     String?  @map("link_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gallery   MediaGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  mediaFile MediaFile    @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@index([mediaFileId])
  @@index([isActive])
  @@map("media_gallery_items")
}

model CmsPage {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  title           String        @db.VarChar(180)
  slug            String        @unique @db.VarChar(180)
  metaTitle       String?       @map("meta_title") @db.VarChar(180)
  metaDescription String?       @map("meta_description") @db.VarChar(255)
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sections CmsSection[]

  @@index([status])
  @@map("cms_pages")
}

model CmsSection {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  pageId      BigInt        @map("page_id") @db.UnsignedBigInt
  sectionKey  String        @map("section_key") @db.VarChar(100)
  title       String?       @db.VarChar(180)
  subtitle    String?       @db.VarChar(255)
  content     String?       @db.LongText
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  buttonLabel String?       @map("button_label") @db.VarChar(120)
  buttonUrl   String?       @map("button_url") @db.VarChar(500)
  sortOrder   Int           @default(0) @map("sort_order")
  status      PublishStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
  @@index([pageId])
  @@index([status])
  @@map("cms_sections")
}

model SiteSetting {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  settingKey   String      @unique @map("setting_key") @db.VarChar(120)
  settingValue String?     @map("setting_value") @db.Text
  settingType  SettingType @default(text) @map("setting_type")
  isPublic     Boolean     @default(false) @map("is_public")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([isPublic])
  @@map("site_settings")
}

model ApprovalLog {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  entityType     ApprovalEntityType @map("entity_type")
  entityId       BigInt             @map("entity_id") @db.UnsignedBigInt
  previousStatus String?            @map("previous_status") @db.VarChar(50)
  newStatus      String             @map("new_status") @db.VarChar(50)
  reviewedBy     BigInt?            @map("reviewed_by") @db.UnsignedBigInt
  reviewComment  String?            @map("review_comment") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")

  reviewedByUser User? @relation("ApprovalReviewedBy", fields: [reviewedBy], references: [id])

  @@index([reviewedBy])
  @@index([entityType, entityId])
  @@map("approval_logs")
}

model FeaturedItem {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  entityType  FeaturedEntityType @map("entity_type")
  entityId    BigInt             @map("entity_id") @db.UnsignedBigInt
  title       String?            @db.VarChar(180)
  description String?            @db.VarChar(255)
  sortOrder   Int                @default(0) @map("sort_order")
  startsAt    DateTime?          @map("starts_at")
  endsAt      DateTime?          @map("ends_at")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("featured_items")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt?     @map("user_id") @db.UnsignedBigInt
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(80)
  entityId    BigInt?     @map("entity_id") @db.UnsignedBigInt
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  description String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserSession {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_user_id")
  @@index([tokenHash], map: "idx_password_reset_token_hash")
  @@index([expiresAt], map: "idx_password_reset_expires_at")
  @@map("password_reset_tokens")
}
